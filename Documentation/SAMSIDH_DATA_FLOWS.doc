<head><title>Samsidh Data Flows</title>
<style>
  body { font-family: 'Segoe UI', Calibri, Arial, sans-serif; padding: 20px; line-height: 1.6; }
  h1 { color: #2c3e50; font-size: 26pt; border-bottom: 3px solid #8e44ad; padding-bottom: 10px; margin-bottom: 30px; }
  h2 { color: #8e44ad; font-size: 18pt; margin-top: 40px; border-bottom: 1px solid #ccc; padding-bottom: 5px; }
