  .note { background-color: #e8f4f8; border-left: 5px solid #3498db; padding: 15px; margin: 20px 0; font-style: italic; }
  .box { background-color: #f8f9fa; border: 1px solid #dee2e6; padding: 20px; border-radius: 5px; margin-bottom: 20px; }
